# Public origin used for absolute links, OpenGraph/Discord embeds, etc.
PUBLIC_URL=http://localhost:3000

# Persistent data directory (SQLite db, uploaded binaries, bindings, exports)
DATA_DIR=./data

# Shared admin password (a handful of trusted admins; no OAuth)
ADMIN_PASSWORD=change-me

# App server bind (adapter-node)
HOST=0.0.0.0
PORT=3000

# --- Worker / IDA configuration -------------------------------------------------
# Single headless IDA binary (IDA 9.0+ merged the 32/64-bit split into one binary).
# Windows dev example:
IDA_PATH=C:\Program Files\IDA Professional 9.2\idat.exe
# Linux (production) example:
# IDA_PATH=/opt/ida/idat

# BromaIDA plugin directory (inside the worker container)
BROMA_PLUGIN_DIR=/opt/ida/plugins

# geode-sdk bindings repository (Broma format) applied in `broma` mode
BINDINGS_REPO_URL=https://github.com/geode-sdk/bindings
# Pin a specific bindings commit for reproducibility (empty = latest)
BINDINGS_COMMIT=
