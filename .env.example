# Public origin used for absolute links, OpenGraph/Discord embeds, etc.
PUBLIC_URL=http://localhost:3000

# Persistent data directory (SQLite db, uploaded binaries, bindings, exports)
DATA_DIR=./data

# Shared admin password (a handful of trusted admins; no OAuth)
ADMIN_PASSWORD=change-me

# App server bind (adapter-node)
HOST=0.0.0.0
PORT=3000

# Request body size limit (adapter-node). Default is 512K, which is far too small
# for binary uploads. Set to Infinity or a large value like 1G.
BODY_SIZE_LIMIT=Infinity

# --- Deployment (Docker compose) -------------------------------------------------
# Host port the app binds to (set to 3000 for plain static hosting on localhost).
APP_PORT=3000

# Decompilation parallelism (number of IDA jobs run at once). IDA analysis is
# mostly single-threaded, so several binaries can decompile in parallel.
WORKER_CONCURRENCY=2

# Optional nginx-proxy + acme-companion integration:
#   docker compose -f compose.yaml -f compose.nginx.yml up -d
# Leave DOMAIN empty to skip it entirely.
DOMAIN=
# Name of the external nginx-proxy network (created by nginx-proxy/acme-companion).
NGINX_NETWORK=nginx-proxy

# --- Worker / IDA configuration -------------------------------------------------
# Single headless IDA binary (IDA 9.0+ merged the 32/64-bit split into one binary).
# Windows dev example:
IDA_PATH=C:\Program Files\IDA Professional 9.2\idat.exe
# Linux (production) example:
# IDA_PATH=/opt/ida/idat

# IDA user directory (holds the BromaIDA plugin + per-user config).
# Empty = auto under DATA_DIR. In Docker this is /opt/ida-user.
IDAUSR=

# Docker only: the read-only host IDA dir is copied to IDA_DIR (writable) on first start.
IDA_HOST_DIR=
IDA_DIR=

# BromaIDA plugin directory (contains BromaIDA.py + broma_ida/).
# Windows dev example:
BROMA_PLUGIN_DIR=C:\Program Files\IDA Professional 9.2\plugins
# Linux (production) example:
# BROMA_PLUGIN_DIR=/opt/ida-user/plugins

# BromaIDA repo — the worker auto-clones + installs it if the plugin is missing.
BROMA_REPO_URL=https://github.com/Stazzical/BromaIDA.git

# Local checkout of the geode-sdk bindings repository (Broma files live at <dir>/bindings/<version>).
# The worker auto-clones it if missing.
BINDINGS_DIR=

# geode-sdk bindings repository (Broma format) applied in `broma` mode
BINDINGS_REPO_URL=https://github.com/geode-sdk/bindings
# Pin a specific bindings commit for reproducibility (empty = latest)
BINDINGS_COMMIT=
